PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# SQLite Database Location
DB_PATH=./data/zunotwin.db
UPLOAD_DIR=./data/uploads

# Hardware USB Serial Port (Leave empty for auto-detection of ESP32)
SERIAL_PORT=
SERIAL_BAUD_RATE=115200

# MQTT Broker (Optional)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC_SUB_SENSORS=shrimpsense/tanks/3/sensors
MQTT_TOPIC_PUB_ACTUATORS=shrimpsense/tanks/3/actuators

# Python AI Inference Service
AI_SERVICE_URL=http://127.0.0.1:8000

# Failsafe Timing (Seconds)
HEARTBEAT_TIMEOUT_SECONDS=5.0
STALE_DATA_THRESHOLD_SECONDS=10.0

# Tank Defaults
DEFAULT_TANK_ID=tank-01
# Security & Authentication
ADMIN_API_KEY=zuno-secret-key-2026
JWT_SECRET=your-random-jwt-secret-key-change-in-production
COOKIE_SECRET=your-random-cookie-secret-key
SESSION_EXPIRY=24h
